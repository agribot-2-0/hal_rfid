<launch>
  <arg name="ip" default="192.168.0.2"/>
  <arg name="port" default="4007"/>
  <arg name="ant_front_port" default="1"/>
  <arg name="ant_front_pwr" default="22.0"/>
  <arg name="ant_back_port" default="2"/>
  <arg name="ant_back_pwr" default="22.0"/>

  <node name="hal_rfid_node" pkg="hal_rfid" type="hal_rfid_node"
        args="$(arg ip) $(arg port) $(arg ant_front_port) $(arg ant_front_pwr) $(arg ant_back_port) $(arg ant_back_pwr)" />
</launch>
